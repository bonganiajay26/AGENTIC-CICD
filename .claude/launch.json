{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "FastAPI Dev Server",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8080"],
      "port": 8080
    },
    {
      "name": "Docker App",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["run", "--rm", "-p", "8080:8080", "my-app:local"],
      "port": 8080
    }
  ]
}
